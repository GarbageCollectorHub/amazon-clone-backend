@model ProductGalleryEditorViewModel
<div class="product-gallery-editor js-product-gallery-editor" data-max-gallery-images="@Model.MaxGalleryImages" data-max-file-bytes="@Model.MaxFileBytes" data-allow-existing-reorder="@Model.AllowExistingReorder.ToString().ToLowerInvariant()" data-existing-ids-field-prefix="@Model.ExistingIdsFieldPrefix" data-is-edit-mode="@Model.IsEditMode.ToString().ToLowerInvariant()">
    <div class="product-gallery-editor__topbar">
        <h2 class="panel__title">@Model.Title</h2>
        <span class="js-pge-count gallery-count" hidden></span>
    </div>
    <p class="product-gallery-editor__description">@(Model.AllowExistingReorder ? $"Drag images to reorder. Up to {Model.MaxGalleryImages} images." : $"Add up to {Model.MaxGalleryImages} gallery images.")</p>
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3 js-pge-toast-container" style="z-index: 1080;"></div>
    @if (!string.IsNullOrWhiteSpace(Model.ExistingIdsFieldPrefix))
    {
        <div class="js-pge-existing-ids-container">
            @for (int i = 0; i < Model.ExistingImages.Count; i++)
            {
                <input type="hidden" name="@($"{Model.ExistingIdsFieldPrefix}[{i}]")" value="@Model.ExistingImages[i].Id" />
            }
        </div>
    }
    <input type="file" class="visually-hidden js-pge-new-files-input" name="@Model.NewFilesInputName" multiple accept=".jpg,.jpeg,.png,.webp" aria-label="Add gallery images" />
    <div class="product-gallery-editor__drop-zone js-pge-drop-zone">
        @if (Model.IsEditMode)
        {
            <div class="product-gallery-editor__section js-pge-existing-section">
                <div class="product-gallery-editor__grid js-pge-existing-grid">
                    @for (int i = 0; i < Model.ExistingImages.Count; i++)
                    {
                        var image = Model.ExistingImages[i];
                        <div class="product-gallery-editor__card product-gallery-editor__card--image js-pge-existing-item position-relative" data-image-id="@image.Id" tabindex="0" aria-label="Gallery image @(i + 1). Use left and right arrow keys to reorder.">
                            <button type="button" class="product-gallery-editor__remove-btn js-pge-remove-existing" title="Remove image" aria-label="Remove gallery image @(i + 1)">
                                <svg class="icon icon--small" aria-hidden="true"><use href="#i-close" /></svg>
                            </button>
                            <img src="@image.Url" alt="Gallery image @(i + 1)" class="product-gallery-editor__thumb" draggable="false" />
                        </div>
                    }
                </div>
            </div>
        }
        <div class="product-gallery-editor__section js-pge-new-section">
            <div class="product-gallery-editor__grid js-pge-new-grid">
                <button type="button" class="product-gallery-editor__card product-gallery-editor__add-card js-pge-add-card">
                    <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>
                    <span>Add images</span>
                </button>
            </div>
        </div>
    </div>
    <p class="image-hint">JPG, PNG or WebP. Max 5 MB per image.</p>
    @if (Model.IsEditMode)
    {
        <p class="gallery-new-note" hidden>New images are added after existing images when you save.</p>
    }
    <span class="visually-hidden js-pge-reorder-status" role="status" aria-live="polite"></span>
    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessageFieldName))
    {
        <span class="text-danger field-validation-valid" data-valmsg-for="@Model.ValidationMessageFieldName" data-valmsg-replace="true"></span>
    }
</div>
