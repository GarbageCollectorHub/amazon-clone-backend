@{
    ViewData["Title"] = "Please wait";
}

<div class="management-page">
    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Please wait a moment</h1>
            <p class="management-page__subtitle">You have submitted several product or category changes too quickly.</p>
        </div>
    </div>
    <div class="alert alert-warning" role="alert">
        Please wait one minute before trying again. Your last request was not saved.
    </div>
    <p>Use your browser's Back button to return to the form.</p>
    <a asp-controller="Home" asp-action="Index" class="action-button action-button--primary">Back to dashboard</a>
</div>
