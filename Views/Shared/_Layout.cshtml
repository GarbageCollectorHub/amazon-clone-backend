@using System.Security.Claims
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    bool isAuthorized = Context.User.Identity?.IsAuthenticated == true;
    string? userName = User.FindFirstValue(ClaimTypes.Email);
    string firstLetter = string.IsNullOrWhiteSpace(userName) ? "U" : userName[..1].ToUpperInvariant();
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string target, string? targetAction = null) => controller == target && (targetAction == null || action == targetAction) ? " is-active" : "";
    string? parentTitle = ViewData["ParentTitle"] as string;
    string? parentUrl = ViewData["ParentUrl"] as string;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] | AMZN Admin</title>
        <script>
            (function () {
                try {
                    var stored = localStorage.getItem("theme-mode");
                    var theme = stored === "dark" || stored === "light" ? stored
                        : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                    document.documentElement.setAttribute("data-bs-theme", theme);
                } catch (e) { document.documentElement.setAttribute("data-bs-theme", "light"); }
            })();
        </script>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/management-pages.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/product-gallery-editor.css" asp-append-version="true" />
        @await RenderSectionAsync("Styles", required: false)
    </head>
    <body class="theme-scope" data-image-placeholder="@Url.Content("~/images/product-placeholder.svg")">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <partial name="_AdminIcons" />
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" id="adminSidebar" tabindex="-1" aria-label="Management navigation">
            <div class="sidebar-inner">
                <div class="sidebar-brand">
                    <a class="brand brand--admin" asp-controller="Home" asp-action="Index" aria-label="AMZN admin home">
                        <span class="brand-wordmark">AMZN<span class="brand-mark" aria-hidden="true"></span></span>
                        <span class="brand-caption">ADMIN PANEL</span>
                    </a>
                    <button class="sidebar-close" type="button" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close navigation">
                        <svg class="icon" aria-hidden="true"><use href="#i-close" /></svg>
                    </button>
                </div>
                <nav class="sidebar-nav" aria-label="Catalog management">
                    <a class="sidebar-link@(Active("Home", "Index"))" asp-controller="Home" asp-action="Index" aria-current="@(Active("Home", "Index") != "" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="#i-home" /></svg>
                        Dashboard
                    </a>
                    <a class="sidebar-link@(Active("AdminProducts"))" asp-controller="AdminProducts" asp-action="Index" aria-current="@(controller == "AdminProducts" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
                        My products
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="sidebar-link@(Active("AdminBrands"))" asp-controller="AdminBrands" asp-action="Index" aria-current="@(controller == "AdminBrands" ? "page" : null)">
                            <svg class="icon" aria-hidden="true"><use href="#i-tag" /></svg>
                            Brands
                        </a>
                        <a class="sidebar-link@(Active("Admin", "Category"))" asp-controller="Admin" asp-action="Category" aria-current="@(action == "Category" ? "page" : null)">
                            <svg class="icon" aria-hidden="true"><use href="#i-layers" /></svg>
                            Categories
                        </a>
                        <a class="sidebar-link@(Active("Admin", "Promotions"))" asp-controller="Admin" asp-action="Promotions" aria-current="@(action == "Promotions" ? "page" : null)">
                            <svg class="icon" aria-hidden="true"><use href="#i-promotion" /></svg>
                            Promotions
                        </a>
                        <div class="sidebar-separator" role="separator"></div>
                        <a class="sidebar-link@(Active("Admin", "SignUp"))" asp-controller="Admin" asp-action="SignUp">
                            <svg class="icon" aria-hidden="true"><use href="#i-user" /></svg>
                            Add user
                        </a>
                    }
                </nav>
            </div>
        </aside>
        <header class="admin-topbar">
            <div class="topbar-location">
                <button class="menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open navigation">
                    <svg class="icon" aria-hidden="true"><use href="#i-menu" /></svg>
                </button>
                <a class="brand brand--admin topbar-brand" asp-controller="Home" asp-action="Index" aria-label="AMZN admin home">
                    <span class="brand-wordmark">AMZN<span class="brand-mark" aria-hidden="true"></span></span>
                    <span class="brand-caption">ADMIN PANEL</span>
                </a>
                <nav class="page-breadcrumb" aria-label="Breadcrumb">
                    <a href="@(parentUrl ?? Url.Action("Index", "Home"))">@(parentTitle ?? "Catalog")</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page">@ViewData["Title"]</span>
                </nav>
            </div>
            <nav class="topbar-actions" aria-label="Account and display settings">
                @if (Configuration.GetValue<bool>("Swagger:Enabled"))
                {
                    <a class="topbar-button api-docs-button" href="@Url.Content("~/swagger")" target="_blank" rel="noopener" title="Open Swagger API documentation" aria-label="API documentation (opens a new tab)">
                        <svg class="icon icon--small" aria-hidden="true"><use href="#i-code" /></svg>
                        <span class="api-docs-label--full">API documentation</span>
                        <span class="api-docs-label--short">API docs</span>
                        <svg class="icon icon--small api-docs-external" aria-hidden="true"><use href="#i-external" /></svg>
                    </a>
                }
                <button type="button" id="theme-toggle" class="topbar-button" title="Dark theme" aria-label="Dark theme" aria-pressed="false">
                    <svg class="icon icon--small theme-icon-dark" aria-hidden="true"><use href="#i-moon" /></svg>
                    <svg class="icon icon--small theme-icon-light" aria-hidden="true"><use href="#i-sun" /></svg>
                    <span class="theme-label">Dark theme</span>
                </button>
                <div class="topbar-account">
                    @if (isAuthorized)
                    {
                        <form asp-controller="Admin" asp-action="Logout" method="post">
                            <button type="submit" class="topbar-button" title="@userName">
                                <span class="account-avatar" aria-hidden="true">@firstLetter</span>
                                Sign out
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="topbar-button" data-bs-toggle="modal" data-bs-target="#authModal">Sign in</button>
                        <a class="action-button action-button--secondary" asp-controller="Admin" asp-action="SignUp">Register</a>
                    }
                </div>
            </nav>
        </header>
        <div class="admin-workspace">
            <main class="admin-content" id="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
        <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="authModalLabel">Sign in</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="auth-modal-form" class="auth-fields">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="form-label" for="auth-email">Email</label>
                                <input id="auth-email" name="Email" type="email" class="form-control" autocomplete="username" required />
                            </div>
                            <div>
                                <label class="form-label" for="auth-password">Password</label>
                                <input id="auth-password" name="Password" type="password" class="form-control" autocomplete="current-password" required />
                            </div>
                        </form>
                        <p id="auth-progress" class="auth-progress mt-3 mb-0" role="status" hidden>This is taking a little longer. Please wait.</p>
                        <div id="message" class="auth-feedback mt-3" role="alert"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="action-button action-button--secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" form="auth-modal-form" class="action-button action-button--primary auth-submit">
                            <span class="spinner-border spinner-border-sm auth-submit__spinner" aria-hidden="true"></span>
                            <span class="auth-submit__label">Sign in</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_SuccessToast" model='TempData["Success"] as string' />
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
        <script src="~/js/admin-ui.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
