@model AMZN.Models.Category.CategoryViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Add category";

    bool isAuthorized = Context.User.Identity?.IsAuthenticated == true;
    string? role = Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/management-pages.css" asp-append-version="true" />
}

<div class="management-page">

    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Add category</h1>
            <p class="management-page__subtitle">
                Create a new root category or subcategory for the product catalog.
            </p>
        </div>
    </div>

    @if (!isAuthorized)
    {
        <div class="alert-box alert-box--danger" role="alert">
            You are not authorized to view this page.
        </div>
    }
    else if (role != "Admin")
    {
        <div class="alert-box alert-box--danger" role="alert">
            Admin role is required to manage categories.
        </div>
    }
    else
    {
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <form asp-action="AddCategory" method="post" enctype="multipart/form-data">

            <section class="panel panel--full">

                <div class="form-grid form-grid--2">

                    <div class="field-group">
                        <label asp-for="Form.Name" class="form-label">Name</label>
                        <input asp-for="Form.Name" class="form-control" />
                        <span asp-validation-for="Form.Name" class="text-danger"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Form.ParentCategory" class="form-label">Parent category</label>
                        <select asp-for="Form.ParentCategory" class="form-select">
                            <option value="">None (root category)</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Form.ParentCategory" class="text-danger"></span>
                    </div>

                </div>

                <div class="form-grid" style="margin-top: 16px;">

                    <div class="field-group">
                        <label asp-for="Form.Description" class="form-label">Description</label>
                        <textarea asp-for="Form.Description" class="form-control"></textarea>
                        <span asp-validation-for="Form.Description" class="text-danger"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Form.Image" class="form-label">Cover image</label>
                        <input asp-for="Form.Image"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="Form.Image" class="text-danger"></span>
                    </div>

                </div>
            </section>

            <div class="action-bar">
                <button type="submit" class="action-button action-button--primary">
                    Add category
                </button>
            </div>

        </form>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
