@model AMZN.Models.User.UserSignUpViewModel
@{
    ViewData["Title"] = "Sign up";
}

@section Styles {
    <link rel="stylesheet" href="~/css/management-pages.css" asp-append-version="true" />
}

<div class="management-page">

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7 col-xl-6">

            <div class="management-page__header">
                <div>
                    <h1 class="management-page__title">Register</h1>
                    <p class="management-page__subtitle">Create a new user account.</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <form asp-action="Register" method="post">

                <section class="panel">

                    <div class="form-grid form-grid--2">
                        <div class="field-group">
                            <label asp-for="Form.FirstName" class="form-label">First name</label>
                            <input asp-for="Form.FirstName" class="form-control" />
                            <span asp-validation-for="Form.FirstName" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.LastName" class="form-label">Last name</label>
                            <input asp-for="Form.LastName" class="form-control" />
                            <span asp-validation-for="Form.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-grid form-grid--2 mt-3">
                        <div class="field-group">
                            <label asp-for="Form.Email" class="form-label">Email</label>
                            <input asp-for="Form.Email" type="email" class="form-control" />
                            <span asp-validation-for="Form.Email" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.Role" class="form-label">Role</label>
                            <select asp-for="Form.Role" class="form-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                                <option value="Moderator">Moderator</option>
                            </select>
                            <span asp-validation-for="Form.Role" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-grid form-grid--2 mt-3">
                        <div class="field-group">
                            <label asp-for="Form.Password" class="form-label">Password</label>
                            <input asp-for="Form.Password" type="password" class="form-control" />
                            <span asp-validation-for="Form.Password" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.ConfirmPassword" class="form-label">Confirm password</label>
                            <input asp-for="Form.ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="Form.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                </section>

                <div class="action-bar">
                    <button type="submit" class="action-button action-button--primary">
                        Create account
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
