@model AMZN.Models.Promotions.PromotionViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Create promotion";

    bool isAuthorized = Context.User.Identity?.IsAuthenticated == true;
    string? role = Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/management-pages.css" asp-append-version="true" />
}

<div class="management-page">

    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Create promotion</h1>
            <p class="management-page__subtitle">
                Create a discount for a product or category.
            </p>
        </div>
    </div>

    @if (!isAuthorized)
    {
        <div class="alert-box alert-box--danger" role="alert">
            You are not authorized to view this page.
        </div>
    }
    else if (role != "Admin")
    {
        <div class="alert-box alert-box--danger" role="alert">
            Admin role is required to manage promotions.
        </div>
    }
    else
    {
        <div id="promotion-feedback"></div>

        <form id="add-promotion-form">
            @Html.AntiForgeryToken()

            <section class="panel panel--full">

                <div class="form-grid form-grid--2">
                    <div class="field-group">
                        <label class="form-label" for="promotion-name">Name</label>
                        <input id="promotion-name" name="promotion-name" class="form-control" />
                    </div>
                    <div class="field-group">
                        <label class="form-label" for="apply-to">Apply to</label>
                        <select id="apply-to" name="apply-to" class="form-select">
                            <option value="product">Single product</option>
                            <option value="category">Whole category</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid form-grid--2 mt-3">
                    <div class="field-group">
                        <label class="form-label" for="product-title">Product / Category name</label>
                        <input id="product-title" name="product-title" class="form-control" />
                    </div>
                    <div class="field-group">
                        <label class="form-label" for="promotion-discount-percent">Discount (%)</label>
                        <input id="promotion-discount-percent" name="promotion-discount-percent"
                               type="number" min="1" max="99"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-grid form-grid--2 mt-3">
                    <div class="field-group">
                        <label class="form-label" for="promotion-start-date">Start date</label>
                        <input id="promotion-start-date" name="promotion-start-date"
                               type="date" class="form-control" />
                    </div>
                    <div class="field-group">
                        <label class="form-label" for="promotion-end-date">End date</label>
                        <input id="promotion-end-date" name="promotion-end-date"
                               type="date" class="form-control" />
                    </div>
                </div>

                <div class="form-grid mt-3">
                    <div class="field-group">
                        <label class="form-label" for="promotion-description">Description</label>
                        <textarea id="promotion-description" name="promotion-description"
                              class="form-control"></textarea>
                    </div>
                </div>

            </section>

            <div class="action-bar">
                <button type="submit" class="action-button action-button--primary">
                    Create promotion
                </button>
            </div>

        </form>
    }

</div>
