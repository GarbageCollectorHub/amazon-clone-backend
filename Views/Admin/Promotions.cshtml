@model AMZN.Models.Promotions.PromotionViewModel
@using AMZN.Shared.Limits
@using System.Security.Claims
@{
    ViewData["Title"] = "Create promotion";

    bool isAuthorized = Context.User.Identity?.IsAuthenticated == true;
    string? role = Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/management-pages.css" asp-append-version="true" />
}

<div class="management-page">

    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Create promotion</h1>
            <p class="management-page__subtitle">
                Create a discount for a product or category.
            </p>
        </div>
    </div>

    @if (!isAuthorized)
    {
        <div class="alert-box alert-box--danger" role="alert">
            You are not authorized to view this page.
        </div>
    }
    else if (role != "Admin")
    {
        <div class="alert-box alert-box--danger" role="alert">
            Admin role is required to manage promotions.
        </div>
    }
    else
    {
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <form asp-action="AddPromotion" method="post">

            <section class="panel panel--full">

                <div class="form-grid form-grid--2">
                    <div class="field-group">
                        <label asp-for="Form.Name" class="form-label">Name</label>
                        <input asp-for="Form.Name" class="form-control" />
                        <span asp-validation-for="Form.Name" class="text-danger"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Form.ApplyTo" class="form-label">Apply to</label>
                        <select asp-for="Form.ApplyTo" class="form-select">
                            <option value="product">Single product</option>
                            <option value="category">Whole category</option>
                        </select>
                        <span asp-validation-for="Form.ApplyTo" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-grid form-grid--2 mt-3">
                    <div class="field-group">
                        <label asp-for="Form.ProductTitle" class="form-label">Product / Category name</label>
                        <input asp-for="Form.ProductTitle" class="form-control" />
                        <span asp-validation-for="Form.ProductTitle" class="text-danger"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Form.DiscountPercent" class="form-label">Discount (%)</label>
                        <input asp-for="Form.DiscountPercent"
                               type="number" min="@CatalogLimits.DiscountPercentMin" max="@CatalogLimits.DiscountPercentMax"
                               class="form-control" />
                        <span asp-validation-for="Form.DiscountPercent" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-grid form-grid--2 mt-3">
                    <div class="field-group">
                        <label asp-for="Form.StartDate" class="form-label">Start date</label>
                        <input asp-for="Form.StartDate"
                               type="date" class="form-control" />
                        <span asp-validation-for="Form.StartDate" class="text-danger"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Form.EndDate" class="form-label">End date</label>
                        <input asp-for="Form.EndDate"
                               type="date" class="form-control" />
                        <span asp-validation-for="Form.EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-grid mt-3">
                    <div class="field-group">
                        <label asp-for="Form.Description" class="form-label">Description</label>
                        <textarea asp-for="Form.Description"
                              class="form-control"></textarea>
                        <span asp-validation-for="Form.Description" class="text-danger"></span>
                    </div>
                </div>

            </section>

            <div class="action-bar">
                <button type="submit" class="action-button action-button--primary">
                    Create promotion
                </button>
            </div>

        </form>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
