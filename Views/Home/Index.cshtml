@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Dashboard";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/admin-home.css" asp-append-version="true" />
}
<div class="management-page">
    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Admin dashboard</h1>
            <p class="management-page__subtitle">Your products, catalog and management tools in one place.</p>
        </div>
    </div>
    @if (Configuration.GetValue<bool>("Swagger:Enabled"))
    {
        <section class="api-overview" aria-labelledby="api-overview-title">
            <div class="api-overview__icon" aria-hidden="true">
                <svg class="icon"><use href="#i-code" /></svg>
            </div>
            <div class="api-overview__copy">
                <h2 id="api-overview-title">Explore the AMZN API</h2>
                <p>This admin panel manages the store catalog. The REST API serves the React storefront.</p>
            </div>
            <a class="action-button action-button--secondary api-docs-button" href="@Url.Content("~/swagger")" target="_blank" rel="noopener" aria-label="Open Swagger (opens a new tab)">
                Open Swagger
                <svg class="icon icon--small" aria-hidden="true"><use href="#i-external" /></svg>
            </a>
        </section>
    }
    <div class="dashboard-sections">
        <section class="dashboard-section">
            <h2>Product management</h2>
            <p>Products and listings</p>
            <a class="dashboard-link" asp-controller="AdminProducts" asp-action="Index">
                <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
                <span>
                    <strong>My products</strong>
                    <small>Edit, restock or remove listings</small>
                </span>
            </a>
            <a class="dashboard-link" asp-controller="AdminProducts" asp-action="Create">
                <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                <span>
                    <strong>Add product</strong>
                    <small>Create a new product</small>
                </span>
            </a>
        </section>
        @if (User.IsInRole("Admin"))
        {
            <section class="dashboard-section">
                <h2>Catalog</h2>
                <p>Structure and metadata</p>
                <a class="dashboard-link" asp-controller="AdminBrands" asp-action="Index">
                    <svg class="icon" aria-hidden="true"><use href="#i-tag" /></svg>
                    <span>
                        <strong>Brands</strong>
                        <small>Manage product brands</small>
                    </span>
                </a>
                <a class="dashboard-link" asp-controller="Admin" asp-action="Category">
                    <svg class="icon" aria-hidden="true"><use href="#i-layers" /></svg>
                    <span>
                        <strong>Categories</strong>
                        <small>Manage the category tree</small>
                    </span>
                </a>
            </section>
            <section class="dashboard-section">
                <h2>Administration</h2>
                <p>Access and promotions</p>
                <a class="dashboard-link" asp-controller="Admin" asp-action="SignUp">
                    <svg class="icon" aria-hidden="true"><use href="#i-user" /></svg>
                    <span>
                        <strong>Add user</strong>
                        <small>Register an account</small>
                    </span>
                </a>
                <a class="dashboard-link" asp-controller="Admin" asp-action="Promotions">
                    <svg class="icon" aria-hidden="true"><use href="#i-promotion" /></svg>
                    <span>
                        <strong>Promotions</strong>
                        <small>Create product or category discounts</small>
                    </span>
                </a>
            </section>
        }
    </div>
</div>
