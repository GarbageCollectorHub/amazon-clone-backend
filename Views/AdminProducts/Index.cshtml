@using AMZN.Models.Product
@using AMZN.Shared.Limits
@using System.Globalization
@model MyProductsListViewModel
@{
    ViewData["Title"] = "My products";
    string? errorMessage = TempData["Error"] as string;
}
@section Styles
{
    <link rel="stylesheet" href="~/css/product-management.css" asp-append-version="true" />
}
<div class="management-page js-products-page">
    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">My products</h1>
            <p class="management-page__subtitle">Manage listings, pricing and stock.</p>
        </div>
        <a asp-action="Create" class="action-button action-button--primary">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            Add product
        </a>
    </div>
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-box alert-box--danger" role="alert">@errorMessage</div>
    }
    @if (Model.TotalItems == 0 && Model.Search.Length == 0)
    {
        <div class="empty-state">
            <h2 class="empty-state__title">No products yet</h2>
            <p class="empty-state__text">Start by creating your first product.</p>
            <div class="action-bar action-bar--center">
                <a asp-action="Create" class="action-button action-button--primary">Create product</a>
            </div>
        </div>
    }
    else
    {
        <form asp-action="Index" method="get" class="products-toolbar" role="search">
            <div class="products-search">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label for="product-search" class="visually-hidden">Search products</label>
                <input id="product-search" name="search" value="@Model.Search" maxlength="@CatalogLimits.SearchMaxLength"
                       class="form-control" type="search" placeholder="Search products..." autocomplete="off" />
            </div>
            <div class="products-sort">
                <label for="product-sort" class="visually-hidden">Sort products</label>
                <select id="product-sort" name="sort" class="form-select">
                    <option value="newest" selected="@(Model.Sort == "newest")">Newest first</option>
                    <option value="oldest" selected="@(Model.Sort == "oldest")">Oldest first</option>
                    <option value="title" selected="@(Model.Sort == "title")">Title: A to Z</option>
                    <option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: low to high</option>
                    <option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: high to low</option>
                </select>
            </div>
            <button type="submit" class="action-button action-button--secondary">Apply</button>
        </form>
        @if (Model.Products.Count == 0)
        {
            <div class="products-no-results">
                <h2>No matching products</h2>
                <p>Try a different search.</p>
                <a asp-action="Index" asp-route-sort="@Model.Sort" class="action-button action-button--secondary">Clear search</a>
            </div>
        }
        else
        {
        <p class="products-scroll-hint">Swipe the table to see prices, stock and actions.</p>
        <div class="table-card">
            <div class="table-wrap" tabindex="0" role="region" aria-label="Product list, scroll horizontally on smaller screens">
                <table class="management-table products-table">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Price</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Created</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img src="@product.PrimaryImageUrl" alt="" class="products-thumbnail" loading="lazy" />
                                        <span class="products-title-cell">@product.Title</span>
                                    </div>
                                </td>
                                <td class="product-price">@product.CurrentPrice.ToString("C2", CultureInfo.GetCultureInfo("en-US"))</td>
                                <td>
                                    <span class="stock-state @(product.StockQuantity > 0 ? "stock-state--available" : "stock-state--empty")">
                                        <span class="stock-dot" aria-hidden="true"></span>@(product.StockQuantity > 0 ? $"{product.StockQuantity} units" : "Out of stock")</span>
                                </td>
                                <td class="product-created">
                                    <time datetime="@product.CreatedAt.ToString("yyyy-MM-dd")">@product.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</time>
                                </td>
                                <td>
                                    <div class="inline-actions">
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="product-edit-link" aria-label="Edit @product.Title">Edit</a>
                                        <button type="button" class="icon-button icon-button--danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" data-delete-url="@Url.Action("Delete", "AdminProducts", new { id = product.Id })" data-entity-name="@product.Title" data-entity-label="product" aria-label="Delete @product.Title" title="Delete product">
                                            <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="products-toolbar products-pagination">
            <p class="products-count">@Model.TotalItems @(Model.TotalItems == 1 ? "product" : "products")</p>
            @if (Model.TotalPages > 1)
            {
                <nav class="inline-actions" aria-label="Product pages">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
                           asp-route-page="@(Model.Page - 1)" class="action-button action-button--secondary">Previous</a>
                    }
                    <span>Page @Model.Page of @Model.TotalPages</span>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
                           asp-route-page="@(Model.Page + 1)" class="action-button action-button--secondary">Next</a>
                    }
                </nav>
            }
        </div>
        }
    }
</div>
<partial name="_DeleteConfirmModal" />
@section Scripts
{
    <script src="~/js/product-management.js" asp-append-version="true"></script>
}
