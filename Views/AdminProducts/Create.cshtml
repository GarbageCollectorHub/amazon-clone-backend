@using AMZN.Models.Product
@model ProductCreateViewModel
@using AMZN.Shared.Limits
@{
    ViewData["Title"] = "Create product";
    ViewData["ParentTitle"] = "My products";
    ViewData["ParentUrl"] = Url.Action("Index", "AdminProducts");
}
@section Styles
{
    <link rel="stylesheet" href="~/css/product-management.css" asp-append-version="true" />
}
<div class="management-page product-editor-page">
    <div class="management-page__header">
        <div>
            <h1 class="management-page__title">Create product</h1>
            <p class="management-page__subtitle">Add product details, pricing and images.</p>
            <a asp-action="Index" class="back-link product-back-link">
                <svg class="icon icon--small" aria-hidden="true"><use href="#i-back" /></svg>
                Back to products
            </a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert-box alert-box--danger" role="alert">@Model.ErrorMessage</div>
    }
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <form asp-action="Create" asp-controller="AdminProducts" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="product-form-layout">
            <div class="product-form-main">
                <section class="panel" aria-labelledby="product-details-title">
                    <h2 class="panel__title" id="product-details-title">Product details</h2>
                    <div class="form-grid">
                        <div class="field-group">
                            <label asp-for="Form.Title" class="form-label">Title</label>
                            <input asp-for="Form.Title" class="form-control" />
                            <span asp-validation-for="Form.Title" class="text-danger"></span>
                        </div>
                        <div class="form-grid form-grid--2">
                            <div class="field-group">
                                <label asp-for="Form.CategoryId" class="form-label">Category</label>
                                <select asp-for="Form.CategoryId" class="form-select">
                                    <option value="">Select category</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="Form.BrandId" class="form-label">Brand</label>
                                <select asp-for="Form.BrandId" class="form-select">
                                    <option value="">Select brand</option>
                                    @foreach (var brand in Model.Brands)
                                    {
                                        <option value="@brand.Id">@brand.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Form.BrandId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.Description" class="form-label">Description</label>
                            <textarea asp-for="Form.Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Form.Description" class="text-danger"></span>
                        </div>
                    </div>
                </section>
                <section class="panel gallery-panel">
                    @await Html.PartialAsync("_ProductGalleryEditor", new ProductGalleryEditorViewModel
                    {
                        Title = "Gallery images",
                        NewFilesInputName = "Form.Images",
                        ValidationMessageFieldName = "Form.Images",
                        ExistingImages = new List<ExistingProductImageViewModel>(),
                        AllowExistingReorder = false,
                        IsEditMode = false
                    })
                </section>
            </div>
            <div class="product-form-aside">
                <section class="panel" aria-labelledby="product-pricing-title">
                    <h2 class="panel__title" id="product-pricing-title">Pricing and stock</h2>
                    <div class="form-grid">
                        <div class="field-group">
                            <label asp-for="Form.CurrentPrice" class="form-label">Current price</label>
                            <div class="price-input">
                                <span aria-hidden="true">$</span>
                                <input asp-for="Form.CurrentPrice" class="form-control" type="number" min="0" step="0.01" />
                            </div>
                            <span asp-validation-for="Form.CurrentPrice" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.OriginalPrice" class="form-label">Original price <span class="field-optional">(optional)</span>
                            </label>
                            <div class="price-input">
                                <span aria-hidden="true">$</span>
                                <input asp-for="Form.OriginalPrice" class="form-control" type="number" min="0" step="0.01" />
                            </div>
                            <span asp-validation-for="Form.OriginalPrice" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Form.StockQuantity" class="form-label">Stock quantity</label>
                            <input asp-for="Form.StockQuantity" class="form-control" type="number" min="@ProductLimits.StockMin" step="1" />
                            <span asp-validation-for="Form.StockQuantity" class="text-danger"></span>
                        </div>
                    </div>
                </section>
                <section class="panel primary-image-panel" aria-labelledby="primary-image-title">
                    <h2 class="panel__title" id="primary-image-title">Primary image</h2>
                    <img src="~/images/product-placeholder.svg" alt="Primary image preview" class="primary-image-preview js-primary-image-preview" />
                    <div class="primary-image-picker">
                        <input asp-for="Form.PrimaryImage" class="visually-hidden js-primary-image-input" type="file" accept=".jpg,.jpeg,.png,.webp" aria-describedby="primary-image-hint" data-max-file-bytes="@ImageUploadLimits.MaxFileBytes" />
                        <label asp-for="Form.PrimaryImage" class="action-button action-button--secondary">
                            <svg class="icon icon--small" aria-hidden="true"><use href="#i-upload" /></svg>
                            Choose image
                        </label>
                    </div>
                    <p class="image-hint" id="primary-image-hint">JPG, PNG or WebP. Max @ImageUploadLimits.MaxFileMiB MiB.</p>
                    <span asp-validation-for="Form.PrimaryImage" class="text-danger"></span>
                    <span class="image-selection-name js-primary-image-name" role="status"></span>
                </section>
            </div>
        </div>
        <div class="action-bar product-form-actions">
            <a asp-action="Index" class="action-button action-button--secondary">Cancel</a>
            <button type="submit" class="action-button action-button--primary">Create product</button>
        </div>
    </form>
</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-gallery-editor.js" asp-append-version="true"></script>
}
