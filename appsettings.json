{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  "AllowedHosts": "*",
  "Swagger": {
    // Enable Swagger UI and links to API documentation.
    "Enabled": true
  },
  "Promotions": {
    // false: check once at startup; true: also check every minute.
    "EnablePeriodicChecks": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_IN_appsettings-Secrets.json"
  }
}
